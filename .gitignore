# Generated packaging outputs (filled by scripts/release-prep.rb — keep the .tpl sources only).
# These files are tracked and the release workflow force-commits them (release.yml does
# `git add -f` in the manifests job): the ignore rules only keep a local regeneration out
# of `git status` — never hand-edit the committed copies.
/packaging/homebrew/nanodictate.rb
/packaging/homebrew/Casks/nanodictate.rb
/packaging/macports/Portfile