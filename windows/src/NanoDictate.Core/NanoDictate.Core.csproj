<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NanoDictate.Core</RootNamespace>
    <AssemblyName>NanoDictate.Core</AssemblyName>
    <Description>Thin .NET host adapter over the shared nanodictate-core Rust engine. Owns no product logic.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NanoDictate.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
