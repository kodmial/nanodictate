<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only WinUI 3 entrypoint. Built only on Windows
       (dotnet build windows/src/NanoDictate.App on windows-latest);
       the cross-platform solution stays on net8.0 so Linux/macOS
       verification never needs the Windows App SDK. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NanoDictate.App</RootNamespace>
    <AssemblyName>NanoDictate.App</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Windows App SDK / WinUI 3 entrypoint for NanoDictate on the shared Rust engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" />
    <ProjectReference Include="..\NanoDictate.Core\NanoDictate.Core.csproj" />
  </ItemGroup>
</Project>
