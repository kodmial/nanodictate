{
  "contract": "nanodictate.shared-hud",
  "version": 1,
  "reference": {
    "platform": "macOS",
    "sources": [
      "Sources/NanoDictateCore/OverlayController.swift",
      "Sources/NanoDictateCore/OverlayLevel.swift",
      "Sources/NanoDictateCore/OverlayLifecycle.swift"
    ]
  },
  "description": "Executable presentation contract for the visible microphone HUD. Rust owns session/readiness/level primitives; each native host owns rendering, positioning, timers, accessibility, and its terminal UI events.",
  "constants": {
    "dbfs_floor": -50.0,
    "attack_seconds": 0.07,
    "release_seconds": 0.5,
    "peak_hold_seconds": 0.8,
    "peak_fall_rate_per_second": 0.7,
    "meter_tick_seconds": 0.05,
    "starting_grace_seconds": 0.12,
    "stroke_min_points": 3.0,
    "stroke_max_points": 9.0,
    "hot_threshold_dbfs": -6.0,
    "ring_diameter_points": 68.0,
    "rec_dot_diameter_points": 8.0,
    "processing_dot_count": 3,
    "panel_corner_radius_points": 10.0,
    "panel_min_width_points": 180.0,
    "panel_max_width_points": 240.0,
    "panel_height_idle_points": 150.0,
    "panel_height_recording_points": 178.0,
    "clock_tick_seconds": 1.0
  },
  "timing": {
    "terminal_hide_seconds": {
      "insert": 0.8,
      "cancelled": 0.8,
      "empty_result": 0.8,
      "error": 2.0,
      "microphone_error": 2.0
    },
    "processing_watchdog": "Transcriber.networkRequestTimeout + 5 s minimum; realtime/failover paths may extend it, never shorten it.",
    "hide_recheck": "At the deadline, hide only when the scheduling cycle is still current and the engine state is Idle."
  },
  "appearance": {
    "session_label": "resolved provider and model, two lines; relay route prefix is preserved",
    "release_version": "OverlayVersion v-prefixed release string in the header",
    "recording_indicator": "REC dot only in Recording",
    "ring": "accent-colored arc from 0..meter, 3..9 pt stroke",
    "peak": "dot at peak angle, ~0.8 s hold then decay",
    "timer": "m:ss, starts only at the first valid buffer",
    "processing": "three animated dots until a terminal result",
    "reduce_motion": "no pulsing; meter and peak follow the target directly and animations are static"
  },
  "positioning": {
    "owner": "native presentation, not Rust and not this fixture",
    "anchor_fallbacks": [
      "caret",
      "pointer",
      "screen_center"
    ],
    "gap_points": 12.0,
    "screen_margin_points": 8.0,
    "note": "The macOS reference clamps the panel to the active screen; Windows intends the same caret/mouse/center policy within its screen and DPI bounds. No pixel or window layout is enforced through FFI."
  },
