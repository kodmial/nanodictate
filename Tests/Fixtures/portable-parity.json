  "request_cases": [
    {
      "name": "openai-default-model-multipart",
      "provider": {
        "id": "openai",
        "base_url": "",
        "model": "",
        "api_key": "sk-test"
      },
      "language": "ru",
      "prompt": "Kubernetes",
      "needs_word_timestamps": false,
      "expected": {
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authorization": "Bearer sk-test",
        "fields": {
          "model": "gpt-transcribe",
          "languages[]": "ru",
          "prompt": "Kubernetes"
        },
        "absent": [
          "language",
          "response_format",
          "timestamp_granularities[]"
        ],
        "file_content_type": "audio/wav"
      }
    },
    {
      "name": "openai-whisper-segment-timestamps",
      "provider": {
        "id": "openai",
        "base_url": "",
        "model": "whisper-1",
        "api_key": "sk-test"
      },
      "language": "ru",
      "prompt": "Kubernetes",
      "needs_word_timestamps": true,
      "expected": {
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authorization": "Bearer sk-test",
        "fields": {
          "model": "whisper-1",
          "language": "ru",
          "prompt": "Kubernetes",
          "response_format": "verbose_json",
          "timestamp_granularities[]": "word"
        },
        "absent": [
          "languages[]"
        ],
        "file_content_type": "audio/wav"
      }
    },
