        "segment_provider": "",
        "final_provider": "",
        "providers": [
          {
            "id": "custom",
            "name": "Custom",
            "base_url": "https://custom.test/v1/audio/transcriptions",
            "model": "custom-model"
          }
        ],
        "resolved_api_keys": {
