    {
      "name": "per-provider-key-file-and-routing",
      "env": {},
      "config": [
        "active_provider = \"openai\"",
        "language = \"en\"",
        "providers = [\"local\", \"groq\", \"openai\", \"missing\"]",
        "[routing]",
        "segment_provider = \"groq\"",
        "final_provider = \"local\"",
        "[providers.openai]",
        "name = \"OpenAI\"",
        "base_url = \"\"",
        "model = \"\"",
        "api_key = \"openai-file-key\"",
        "[providers.groq]",
        "name = \"Groq\"",
        "base_url = \"\"",
        "model = \"\"",
        "api_key_file = \"${KEY_DIR}/groq.key\"",
        "[providers.local]",
        "name = \"Local\"",
        "base_url = \"https://local.test/v1/audio/transcriptions\"",
        "model = \"custom-model\""
      ],
      "files": {
        "groq.key": "# provider key\n\"groq-file-key\"\n"
      },
      "expected": {
        "active_provider": "openai",
        "language": "en",
        "segment_provider": "groq",
        "final_provider": "local",
        "providers": [
          {
            "id": "openai",
            "name": "OpenAI",
            "base_url": "",
            "model": ""
          },
          {
            "id": "groq",
            "name": "Groq",
            "base_url": "",
            "model": ""
          },
          {
            "id": "local",
            "name": "Local",
            "base_url": "https://local.test/v1/audio/transcriptions",
            "model": "custom-model"
          }
        ],
        "resolved_api_keys": {
          "openai": "openai-file-key",
          "groq": "groq-file-key",
          "local": ""
        },
        "failover_order": [
          "local",
          "groq",
          "openai"
        ]
      }
    },
    {
      "name": "active-env-key-scopes-to-active-provider",
      "env": {
        "NANODICTATE_API_KEY": "env-active-key"
      },
      "config": [
        "active_provider = \"openai\"",
        "[providers.openai]",
        "api_key = \"openai-file-key\"",
        "[providers.groq]",
        "api_key = \"groq-file-key\"",
        "[providers.cloudflare]",
        "api_key_file = \"${KEY_DIR}/cloudflare.key\""
      ],
      "files": {
        "cloudflare.key": "cloudflare-file-key\n"
      },
      "expected": {
        "active_provider": "openai",
        "language": "",
        "segment_provider": "",
        "final_provider": "",
        "providers": [
          {
            "id": "openai",
            "name": "",
            "base_url": "",
            "model": ""
          },
          {
            "id": "groq",
            "name": "",
            "base_url": "",
            "model": ""
          },
          {
            "id": "cloudflare",
            "name": "",
            "base_url": "",
            "model": ""
          }
        ],
        "resolved_api_keys": {
          "openai": "env-active-key",
          "groq": "groq-file-key",
          "cloudflare": "cloudflare-file-key"
        },
        "failover_order": [
          "openai",
          "groq",
          "cloudflare"
        ]
      }
    },
    {
      "name": "empty-active-env-applies-to-first-provider-only",
      "env": {
        "NANODICTATE_API_KEY": "env-first-key"
      },
      "config": [
        "language = \"de\"",
        "[providers.first]",
        "api_key = \"first-file-key\"",
        "[providers.second]",
        "api_key = \"second-file-key\""
      ],
      "files": {},
      "expected": {
        "active_provider": "",
        "language": "de",
        "segment_provider": "",
        "final_provider": "",
        "providers": [
          {
            "id": "first",
            "name": "",
            "base_url": "",
            "model": ""
          },
          {
            "id": "second",
            "name": "",
            "base_url": "",
            "model": ""
          }
        ],
        "resolved_api_keys": {
          "first": "env-first-key",
          "second": "second-file-key"
        },
        "failover_order": [
          "first",
          "second"
        ]
      }
    },
    {
      "name": "openai-compatible-unknown-options-ignored",
      "env": {},
      "config": [
        "active_provider = \"custom\"",
