{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "skip-github-release": true,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "refactor", "section": "Changed" },
    { "type": "revert", "section": "Changed" },
    { "type": "security", "section": "Security" },
    { "type": "deprecate", "section": "Deprecated" },
    { "type": "remove", "section": "Removed" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "go",
      "versioning": "always-bump-patch",
      "skip-changelog": true,
      "skip-github-release": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "pull-request-header": ":robot: NanoDictate Release PR — merges here publish the next version. Do not edit the version by hand; merge this PR to release.",
      "extra-files": [
        {
          "type": "generic",
          "path": "Sources/NanoDictateCore/Version.swift"
        }
      ],
      "exclude-paths": [
        "Sources/NanoDictateCore/Version.swift",
        "CHANGELOG.md",
        "README.md",
        "SECURITY.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        ".gitignore",
        ".swift-format",
        ".swiftlint.yml",
        ".coderabbit.yaml",
        "docs",
        ".github",
        ".githooks",
        "packaging",
        "nanodictate.rb",
        "config.example.toml"
      ]
    }
  }
}
